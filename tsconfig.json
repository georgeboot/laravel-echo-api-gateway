{
    "compilerOptions": {
        "declaration": true,
        "declarationDir": "./dist",
        "module": "es2015",
        "moduleResolution": "node",
        "outDir": "./dist",
        "sourceMap": false,
        "target": "es2017",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "typeRoots": [
            "node_modules/@types"
        ],
        "lib": [
            "es2017",
            "dom"
        ]
    },
    "include": [
        "./typings/",
        "./js-src/"
    ]
}
